{
  "name": "cloudshop-worker",
  "main": "src/index.ts",
  "compatibility_date": "2024-11-07",
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true
    }
  },
  // -----------------------------------------------------------
  // Default / Production Configuration
  // -----------------------------------------------------------
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cloudshop",
      "database_id": "local-db"
    }
  ],
  "r2_buckets": [
    {
      "binding": "R2",
      "bucket_name": "cloudshop-uploads"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "KV",
      "id": "cloudshop-kv"
    }
  ],

  // -----------------------------------------------------------
  // Development Environment
  // -----------------------------------------------------------
  "env": {
    "development": {
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "cloudshop",
          "database_id": "local-db"
          // Defaults to a local simulation
        }
      ],
      "r2_buckets": [
        {
          "binding": "R2",
          "bucket_name": "cloudshop-uploads"
          // Local R2 simulation for localhost development (no Cloudflare credentials required)
        }
      ],
      "kv_namespaces": [
        {
          "binding": "KV",
          "id": "cloudshop-kv"
          // Defaults to a local simulation
        }
      ]
    },

    // -----------------------------------------------------------
    // Production Environment
    // -----------------------------------------------------------
    // TODO make names dynamic based on the environment (e.g. cloudshop-uploads-production, cloudshop-uploads-staging)
    "production": {
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "cloudshop-db-production",
          "database_id": "fe76b500-2b01-4cd6-b8b6-b9cf1d378218"
        }
      ],
      "r2_buckets": [
        {
          "binding": "R2",
          "bucket_name": "cloudshop-uploads-production"
        }
      ],
      "kv_namespaces": [
        {
          "binding": "KV",
          // "name": "cloudshop-kv-production"
          "id": "0e9ca071ef2a4986b70ecac3d411576a"
        }
      ],
      "vars": {
        "ENVIRONMENT": "production",
        "USE_MOCKS": "true"
      }
    }
  }
}